{
  "name": "@srobroek/sniff",
  "version": "0.1.0",
  "description": "Portable code-smell auditing for OMP, Claude Code, and Codex.",
  "private": true,
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "mcp": "bun run adapters/mcp/server.ts"
  },
  "omp": {
    "extensions": [
      "./extensions/sniff-install-tool.ts",
      "./extensions/sniff-intake-tool.ts",
      "./extensions/sniff-report-tool.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@oh-my-pi/pi-ai": "18.1.14",
    "@oh-my-pi/pi-coding-agent": "18.1.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.20.0"
  }
}
