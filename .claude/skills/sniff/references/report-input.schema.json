{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srobroek/sniff/blob/main/skills/sniff/references/report-input.schema.json",
  "title": "Sniff report input",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "target", "headline", "findings", "coverage", "suppressionCount", "systemicPatterns"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "target": {
      "description": "Copy reportTarget from sniff_intake, then add languages. Do not add root, paths, materialization, immutableRef, or headRef.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "scopeMode", "languages", "filesAnalyzed"],
      "properties": {
        "kind": { "enum": ["whole-repo", "area", "directory", "files", "uncommitted", "commit", "range", "branch", "ref", "repository", "pr", "mr", "release", "history"] },
        "label": { "type": "string", "minLength": 1 },
        "scopeMode": { "enum": ["quick", "full", "plan-only"] },
        "baseRef": { "type": "string", "minLength": 1 },
        "languages": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "filesAnalyzed": { "type": "integer", "minimum": 0 }
      }
    },
    "headline": { "type": "string", "minLength": 1 },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/findingInput" } },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "suppressionCount": { "type": "integer", "minimum": 0 },
    "systemicPatterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "tool", "analysisClass", "status", "notes"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "analysisClass": { "enum": ["local", "relational", "global", "baseline"] },
        "status": { "enum": ["ran", "skipped", "gap", "not-applicable"] },
        "notes": { "type": "string", "minLength": 1 },
        "config": { "type": "string", "minLength": 1 }
      }
    },
    "findingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableKey", "title", "location", "evidence", "impact", "value", "cost", "compatibility", "applyTier", "adversarial"],
      "properties": {
        "stableKey": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "line", "anchor"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 },
            "anchor": { "type": "string", "minLength": 1 }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "source", "detail"],
          "properties": {
            "tier": { "enum": ["observed", "reproduced", "corroborated", "hypothesis"] },
            "source": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "impact": { "enum": ["critical", "high", "medium", "low"] },
        "value": { "enum": ["high", "medium", "low"] },
        "cost": { "enum": ["S", "M", "L"] },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["safe", "breaking"] },
            "surface": { "type": "string", "minLength": 1 }
          },
          "if": { "properties": { "kind": { "const": "breaking" } } },
          "then": { "required": ["surface"] }
        },
        "applyTier": { "enum": ["mechanical", "assisted", "manual"] },
        "smell": { "$ref": "#/$defs/link" },
        "refactoring": { "$ref": "#/$defs/link" },
        "adversarial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "reason"],
          "properties": {
            "verdict": { "enum": ["keep", "downgrade", "drop"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      },
      "dependentRequired": {
        "smell": ["refactoring"],
        "refactoring": ["smell"]
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://refactoring\\.guru/[A-Za-z0-9/_-]+$" }
      }
    }
  }
}
